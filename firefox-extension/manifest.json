{
  "manifest_version": 2,
  "name": "Reading Manager",
  "version": "1.0.0",
  "description": "Save URLs to Obsidian Reading Manager",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "alarms"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{d9a07c74-ebb6-4c99-8b67-6a135c42045b}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "icons": {
    "48": "icons/icon48.png"
  }
}
